# Copy this file to .env and fill in the keys you have.

# Supabase Postgres - required. In the Supabase dashboard: your project -> Connect ->
# "Direct connection" tab -> copy the URI and fill in your DB password.
# (Not the same as the API URL / anon / service_role / secret keys shown on other tabs -
# those are for the REST/Auth client SDK, not a direct SQL connection.)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# LLM_PROVIDER controls which extraction/relationship-classification backend is used.
# 'mock' needs no key and is the default - it proves pipeline mechanics but not real extraction quality.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenDART (https://opendart.fss.or.kr) - free registration, needed for `cana ingest-dart`.
OPENDART_API_KEY=

# Naver Search API (https://developers.naver.com) - free registration, needed for `cana ingest-news`.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional overrides
COMPANY_ANALYZER_RAW_DATA_DIR=data/raw
